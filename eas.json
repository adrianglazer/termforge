{
  "cli": {
    "version": ">=22.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.4.1",
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "simulator": false
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "developmentClient": false,
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6818173928"
      }
    }
  }
}
